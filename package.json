{
  "name": "emunium-docs",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Emunium documentation. Next.js App Router, Nextra, Tailwind CSS 4 and Pagefind.",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "prebuild": "node scripts/prepare.mjs && node scripts/check-content.mjs",
    "build": "next build --webpack",
    "postbuild": "pagefind --site out --output-path out/_pagefind && node scripts/check-export.mjs",
    "preview": "node scripts/serve.mjs",
    "start": "node scripts/serve.mjs",
    "typecheck": "tsc --noEmit",
    "brand:export": "node scripts/prepare-brand.mjs",
    "check:content": "node scripts/check-content.mjs",
    "check:export": "node scripts/check-export.mjs",
    "docs:import": "node scripts/import-docs.mjs",
    "test:e2e": "playwright test",
    "verify": "npm run build && npm run typecheck && npm run test:e2e"
  },
  "dependencies": {
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "nextra": "4.6.1",
    "nextra-theme-docs": "4.6.1",
    "next-themes": "0.4.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "tailwindcss": "4.3.3",
    "postcss": "^8.5.6",
    "pagefind": "^1.3.0",
    "typescript": "^5.9.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@playwright/test": "^1.56.0",
    "@types/mdx": "^2.0.13"
  }
}
